# Rod's portable Codespaces shell configuration.
# Source of truth: rodkisten/codespaces/zsh/zshrc
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="rod-mobile"
plugins=(git zsh-autosuggestions zsh-completions zsh-syntax-highlighting)
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi
export EDITOR=micro
export VISUAL=micro
export PAGER=less
export LESS="-FRX"
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v fzf >/dev/null && source <(fzf --zsh) 2>/dev/null
alias ll='ls -lah'
alias gs='git status -sb'
alias gp='git pull --ff-only'
alias gco='git checkout'
alias dc='docker compose'
alias k='kubectl'
alias c='clear'
alias ..='cd ..'
# Prefer project-pinned binaries; these are convenience wrappers only.
alias wr='wrangler'
alias pn='pnpm'
alias g='git'
function mkcd() { mkdir -p -- "$1" && cd -- "$1"; }
function extract() {
  if [[ $# -ne 1 || ! -f "$1" ]]; then print -u2 'Usage: extract <archive>'; return 2; fi
  case "$1" in
    *.tar.gz|*.tgz) tar -xzf "$1";;
    *.tar.xz) tar -xJf "$1";;
    *.tar) tar -xf "$1";;
    *.zip) unzip "$1";;
    *) print -u2 'Unsupported archive'; return 2;;
  esac
}
# Mobile-friendly editor: default to personal overrides, keep existing files safe.
# Usage: edit [path]; after editing ~/.zshrc.local, offer remote sync.
function edit() {
  local file="${1:-$HOME/.zshrc.local}"
  local editor
  if command -v micro >/dev/null 2>&1; then
    editor=micro
  elif command -v nano >/dev/null 2>&1; then
    editor=nano
  elif command -v vi >/dev/null 2>&1; then
    editor=vi
  else
    print -u2 '[FAIL] No terminal editor found (micro, nano or vi)'
    return 127
  fi
  if (( $# > 1 )); then
    print -u2 'Usage: edit [file]'
    return 2
  fi
  print -r -- "[RUN] $editor $file"
  "$editor" "$file" || return $?
  print -r -- "[OK] Editor closed: $file"
  if [[ "${file:A}" == "${HOME}/.zshrc.local" ]]; then
    if command -v zsh >/dev/null && ! zsh -n "$file"; then
      print -u2 '[FAIL] Zsh syntax invalid; fix before syncing'
      return 1
    fi
    if command -v rod-sync >/dev/null; then
      print -r -- '[RUN] rod-sync now'
      rod-sync now
    else
      print -r -- '[SKIP] rod-sync unavailable; periodic sync will run if configured'
    fi
  fi
}
# Never store access tokens, secrets or credentials in this tracked file.
# Optional personal overrides. Keep credentials out of shell config.
# Set ROD_LOAD_LOCAL_ZSHRC=0 to disable for one session.
if [[ "${ROD_LOAD_LOCAL_ZSHRC:-1}" == "1" && -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
