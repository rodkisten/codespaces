# Rod's portable Codespaces shell configuration.
# Source of truth: rodkisten/codespaces/zsh/zshrc
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="rod-mobile"
plugins=(git zsh-autosuggestions zsh-completions zsh-syntax-highlighting)
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi
export EDITOR=micro
export VISUAL=micro
export PAGER=less
export LESS="-FRX"
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v fzf >/dev/null && source <(fzf --zsh) 2>/dev/null
alias ll='ls -lah'
alias gs='git status -sb'
alias gp='git pull --ff-only'
alias gco='git checkout'
alias dc='docker compose'
alias k='kubectl'
alias c='clear'
alias ..='cd ..'
# Prefer project-pinned binaries; these are convenience wrappers only.
alias wr='wrangler'
alias pn='pnpm'
alias g='git'
function mkcd() { mkdir -p -- "$1" && cd -- "$1"; }
function extract() {
  if [[ $# -ne 1 || ! -f "$1" ]]; then print -u2 'Usage: extract <archive>'; return 2; fi
  case "$1" in
    *.tar.gz|*.tgz) tar -xzf "$1";;
    *.tar.xz) tar -xJf "$1";;
    *.tar) tar -xf "$1";;
    *.zip) unzip "$1";;
    *) print -u2 'Unsupported archive'; return 2;;
  esac
}
# Never store access tokens, secrets or credentials in this tracked file.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
